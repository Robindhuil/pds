<body><![CDATA[BEGIN IF p_iny IS NULL THEN RETURN 0; END IF; IF trieda IS NULL OR p_iny.trieda IS NULL OR trieda <> p_iny.trieda THEN RETURN 0; END IF; IF rad IS NULL OR p_iny.rad IS NULL OR rad <> p_iny.rad THEN RETURN 1; END IF; IF celad IS NULL OR p_iny.celad IS NULL OR celad <> p_iny.celad THEN RETURN 2; END IF; IF rod IS NULL OR p_iny.rod IS NULL OR rod <> p_iny.rod THEN RETURN 3; END IF; IF epiteton IS NULL OR p_iny.epiteton IS NULL OR epiteton <> p_iny.epiteton THEN RETURN 4; END IF; RETURN 5; END; MAP]]></body>
